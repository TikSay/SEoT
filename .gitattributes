# Auto detect text files and perform LF normalization
* text=auto

# =====================================================
# .gitignore for prosjekt: Java (Maven) + MySQL + HTML/CSS/JS
#
# Prosjektstruktur:
#   backend/    Java-kode (Maven)
#   frontend/   HTML, CSS og JavaScript
#   database/   SQL-skript (schema og testdata)
# =====================================================


# -----------------------------------------------------
# Hemmeligheter og lokal konfigurasjon
# -----------------------------------------------------
.env
.env.*
!.env.example

# Lokale config-filer med databasepassord
backend/src/main/resources/application-local.properties
backend/src/main/resources/db.properties
!backend/src/main/resources/db.properties.example

*.pem
*.key
*.p12
*.jks


# -----------------------------------------------------
# Backend: Java / Maven
# -----------------------------------------------------
backend/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*.log

# Maven wrapper: behold selve wrapperen, ignorer nedlastet jar
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar

# Hvis dere bruker Gradle i stedet for Maven
.gradle/
backend/build/


# -----------------------------------------------------
# Database: MySQL
# -----------------------------------------------------
# schema.sql og seed.sql i database/ SKAL committes.
# Lokale dumper med ekte data skal ikke det.
database/dumps/
*.dump
*.sql.gz
mysql-data/


# -----------------------------------------------------
# Frontend: HTML / CSS / JavaScript
# -----------------------------------------------------
# Kun aktuelt hvis dere senere tar i bruk npm-verktøy
node_modules/
frontend/dist/
npm-debug.log*

# Genererte filer
*.map
.sass-cache/


# -----------------------------------------------------
# IDE-er
# -----------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code (behold delte anbefalinger)
.vscode/*
!.vscode/extensions.json

# NetBeans
nbproject/private/
nbbuild/


# -----------------------------------------------------
# Operativsystem
# -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini


# -----------------------------------------------------
# Logger og midlertidige filer
# -----------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.swp
*~
